# ---------------------------------------------------------------------------
# PCC production environment — TEMPLATE.
#
# Copy this to the server, fill it in, and keep it OUT of the repository:
#
#     C:\ProgramData\pcc\pcc.env
#
# The installer refuses an environment file inside the source checkout, because
# this file holds SESSION_SECRET and a checkout gets cloned, zipped and mailed.
#
# NO REAL VALUE BELONGS IN THIS FILE IN GIT. Every secret below is empty and
# must stay empty here. Fill them in on the server only.
#
# Each entry says: what it controls · required? · who supplies it · secret? ·
# format. "Refuses" means PCC will not start without it — deliberately, because
# the alternative is a production system running on a guess.
# ---------------------------------------------------------------------------


# === RUNTIME ================================================================

# Turns on production behaviour: secure cookies, no dev server, real refusals.
# required · supplied by: deployment · not secret · exactly "production"
NODE_ENV=production

# The loopback port IIS proxies to. NOT exposed to the LAN — see Configure-PCCIIS.ps1.
# optional (default 3000) · supplied by: IT if 3000 is taken · not secret · integer
PORT=3000

# Bind to loopback only. IIS is the only thing that should reach PCC.
# optional (default 0.0.0.0 in the image; set it here) · deployment · not secret
HOSTNAME=127.0.0.1


# === IDENTITY OF THIS COMPANY ===============================================
# These three print on every purchase order that reaches a supplier. They are
# read ONLY when the organization row is created, on the very first start, and
# no screen edits them afterwards. Getting them wrong means paperwork that is
# wrong for the life of the installation.
# PCC REFUSES TO START without the address or the telephone number.

# THE TENANT'S PERMANENT IDENTITY.
#
# Read only when the organization row is created, exactly like the letterhead
# below — but unlike the letterhead it is also how everything OUTSIDE the
# database refers to this organization: the measurement baseline
# (proof/baselines/), any frozen case study, and the backup naming.
#
# Left unset, PCC generates a UUID. That works, and it costs two things worth
# more than the keystrokes:
#   · a baseline cannot be prepared BEFORE go-live, because nobody knows the id
#     yet — and a baseline written afterwards cannot govern work that predates
#     it, so the first real purchases become permanently unmeasurable;
#   · a restore into a fresh database mints a NEW id, and every claim ever made
#     about this organization silently stops matching it.
#
# SET IT, and set it to the same value in any rebuild or restore.
# Lowercase letters, digits, hyphen or underscore; starts with a letter.
# required for measurement · supplied by: us · not secret · PERMANENT
PCC_ORG_ID=lippolis

# required · supplied by: business (Mike/Rick) · not secret · free text
PCC_ORG_NAME=Lippolis Electric, Inc.

# required · REFUSES · supplied by: business · not secret · one free-text line
PCC_ORG_ADDRESS=Licensed Electrical Contractor · 25 Seventh Street, Pelham, NY 10803

# required · REFUSES · supplied by: business · not secret · as it should print
PCC_ORG_PHONE=(914) 738-3550


# === HOW PURCHASE ORDERS ARE NUMBERED =======================================
# Stated, never defaulted: a purchase order number cannot be withdrawn once a
# supplier has it, so an installation that has not established its rule must
# not reach the point of issuing one.
#
# Lippolis: job number + vendor code + a sequence counting from 1 WITHIN THAT
# PAIR — 1234-COOPER-1. Job 1234 with Graybar starts again at 1.
#
# This sets the RULE. The starting sequence for pairs that already have paper
# orders is entered per pair in Admin > PO numbering, after installation.
# required · REFUSES · supplied by: business · not secret · job-vendor-sequence
PCC_PO_NUMBERING=job-vendor-sequence


# === WHERE THE RECORDS LIVE =================================================
# The company's purchasing record. Must be OUTSIDE the application directory —
# a reinstall replaces the application directory.
# required · REFUSES · supplied by: IT · not secret · absolute Windows path
PCC_DATABASE_PATH=C:\ProgramData\pcc\data\pcc.sqlite

# FIRST START ONLY, THEN DELETE THIS LINE.
# While it is unset, a start that finds no database refuses rather than creating
# one — which is what makes a wrong path loud instead of silently standing up an
# empty purchasing system beside the real one.
# optional · supplied by: deployment · not secret · "1" or absent
# PCC_DATABASE_ALLOW_CREATE=1


# === THE ADDRESS PEOPLE TYPE ================================================
# Password-reset links are built from this, and the session cookie's Secure flag
# follows its scheme. Over plain HTTP the browser accepts the cookie and never
# sends it back: every sign-in returns to the sign-in page while health stays
# green. Change this to the https:// address the moment the certificate lands.
# required · REFUSES · supplied by: IT · not secret · absolute http(s) URL
APP_BASE_URL=http://192.168.10.152

# Only while APP_BASE_URL is http://. It records that plain HTTP on a trusted
# internal network is a stated decision rather than an accident. DELETE IT when
# the certificate is installed.
# optional · supplied by: deployment · not secret · "1" or absent
PCC_ALLOW_INSECURE_HTTP=1


# === SECRETS ================================================================
# LEAVE EMPTY IN GIT. Generated on the server, once, and never regenerated:
# changing it signs everybody out.
#
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#
# required · REFUSES · GENERATED during install · SECRET · 32+ characters
SESSION_SECRET=

# How long a signed-in session lasts. 43200 = 12 hours, a working day.
# optional · supplied by: business · not secret · seconds
SESSION_TTL_SECONDS=43200


# === THE FIRST ADMINISTRATOR ================================================
# Used ONLY on the very first start, to create one administrator who can then
# create everybody else. Delete all three afterwards; the account remains.
# PCC forces a password change at first sign-in (schema 0039-must-change-password).
#
# required for the first start only · supplied by: Jack/deployment
PCC_BOOTSTRAP_ADMIN_EMAIL=
PCC_BOOTSTRAP_ADMIN_NAME=
# SECRET. Temporary by design — it must be changed at first sign-in.
PCC_BOOTSTRAP_ADMIN_PASSWORD=


# === PERSISTENCE AND STORAGE ================================================
# "local" is the embedded SQLite store — the internal-first deployment. There is
# no database server and no database port.
# required · supplied by: deployment · not secret · local | supabase
PURCHASING_PERSISTENCE=local

# Local sign-in with passwords PCC holds. No external identity provider.
# required · supplied by: deployment · not secret · local
AUTH_PROVIDER=local

# Delivery evidence (photographs of what arrived) stored in the database.
# optional (default inline) · supplied by: deployment · not secret
STORAGE_DRIVER=inline

# Never 1 in production. Demo mode offers identity selection without a password.
# optional · supplied by: deployment · not secret · must be 0 or absent
PURCHASING_DEMO_MODE=0


# === SET BY THE INSTALLER — DO NOT WRITE THESE BY HAND ======================
# PCC_RELEASE is stamped into the artifact at build time and passed to the
# service by install-production.ps1, so /api/health can answer "which version
# is running?". Writing it here by hand would let the answer drift from the
# code that is actually running.
# PCC_RELEASE=<commit> <build timestamp>
