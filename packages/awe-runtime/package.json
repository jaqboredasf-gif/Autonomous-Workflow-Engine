{
  "name": "@exattime/awe-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The AWE platform service layer: transport-free composition for deterministic runs, registered workflows, bounded agents, and tenant-bound versioned memory. Concrete clocks, stores, model adapters, retrieval adapters, artifacts, and audit sinks are injected.",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./service": "./src/service.mjs",
    "./control-plane-service": "./src/control-plane-service.mjs",
    "./agent-service": "./src/agent-service.mjs",
    "./memory-service": "./src/memory-service.mjs",
    "./execution-service": "./src/execution-service.mjs",
    "./journal-store": "./src/journal-store.mjs",
    "./result-store": "./src/result-store.mjs",
    "./clock": "./src/clock.mjs",
    "./file-sinks": "./src/file-sinks.mjs",
    "./reference/invoice-intake": "./src/reference/invoice-intake.mjs",
    "./reference/operations-agent": "./src/reference/operations-agent.mjs",
    "./reference/durable-operations": "./src/reference/durable-operations.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
