# ---------------------------------------------------------------------------
# Purchasing Control Center — SERVER configuration.
#
#   cp .env.example .env      then fill in the values marked REQUIRED
#
# `.env` is gitignored and must stay that way. NO REAL SECRET BELONGS IN THIS
# FILE — it is a list of names and explanations, and it is committed.
#
# This is the deployment view. apps/purchasing/.env.example is the same
# settings from a developer's point of view, with the local-development
# defaults spelled out.
#
# Everything here is read in one place (src/purchasing/infrastructure/env.ts),
# checked at startup by the preflight (src/instrumentation.ts), and reported on
# by GET /api/health. A misconfigured deployment says so in the logs and
# refuses to serve, rather than coming up wrong.
#
# ---------------------------------------------------------------------------
# WHO SUPPLIES WHAT. On installation day the delay is never "what does this
# variable mean" — it is "whose answer is this?". So:
#
#   VARIABLE                        REQUIRED?   VALUE COMES FROM
#   ------------------------------  ----------  ---------------------------
#   NODE_ENV                        REQUIRED    application default (production)
#   SESSION_SECRET                  REQUIRED    JACK generates, IT stores
#   PCC_DATABASE_PATH               REQUIRED    JACK, agreed with IT (the volume)
#   APP_BASE_URL                    REQUIRED    LIPPOLIS IT (hostname + HTTPS)
#
#   PORT                            optional    LIPPOLIS IT (what the proxy hits)
#   HOSTNAME                        optional    application default (0.0.0.0)
#   SESSION_TTL_SECONDS             optional    application default (12 hours)
#
#   PCC_ORG_NAME                    optional*   PURCHASING — prints on every PO
#   PCC_ORG_PHONE                   optional*   PURCHASING — prints on every PO
#   PCC_ORG_ADDRESS                 optional*   PURCHASING — prints on every PO
#
#   PCC_DATABASE_ALLOW_CREATE       first run   JACK, then REMOVED
#   PCC_BOOTSTRAP_ADMIN_EMAIL       first run   JACK / PURCHASING
#   PCC_BOOTSTRAP_ADMIN_PASSWORD    first run   JACK generates, then REMOVED
#   PCC_BOOTSTRAP_ADMIN_NAME        first run   optional label
#
#   AUTH_PROVIDER                   optional    application default (local)
#   PURCHASING_PERSISTENCE          optional    application default (local)
#   STORAGE_DRIVER / STORAGE_BUCKET optional    application default (inline)
#   NEXT_PUBLIC_SUPABASE_*          only if     LIPPOLIS IT — not used in Phase 1
#   SUPABASE_SERVICE_ROLE_KEY       supabase    LIPPOLIS IT — not used in Phase 1
#   AUTH_REDIRECT_URL                           LIPPOLIS IT — not used in Phase 1
#
#   PURCHASING_DEMO_MODE            never       development only; refused in production
#
#   * optional to START, but they print on the purchase order that goes to a
#     supplier. Treat them as required before the first real order.
#
# PURCHASE ORDER NUMBERING IS NOT CONFIGURATION. A number is the job, the
# vendor and a count that starts at 1 for that pair — 1234-COOPER-1 — so there
# is nothing to set here and no starting number to supply. The only numbering
# input a person gives is a job-and-vendor pair the office has ALREADY written
# paper orders for, entered once in Administration → PO numbering. It is not an
# environment variable because it must not be settable by whoever edits a file.
# ---------------------------------------------------------------------------

# --- REQUIRED ---------------------------------------------------------------

# Must be `production` on a server. It is what makes a missing session secret
# and a guessed database path fatal instead of merely noted.
NODE_ENV=production

# REQUIRED. Signs the session cookie. At least 32 characters, from a random
# source, kept in whatever secret store IT already uses. Changing it signs
# everybody out; losing it means nobody can sign in until it is replaced.
#
#   openssl rand -base64 48
#
# The application refuses to start in production without one.
SESSION_SECRET=

# REQUIRED. Where the company's purchasing records live. An absolute path
# inside the mounted persistent volume — never a path inside the container.
# The application refuses to start if the directory does not exist.
PCC_DATABASE_PATH=/data/pcc.sqlite

# REQUIRED. The address people type. Used for password-reset links, so a wrong
# value produces links that go nowhere.
APP_BASE_URL=https://pcc.example.internal

# --- FIRST INSTALL ONLY -----------------------------------------------------

# Set to 1 for the very first start, then REMOVE IT. While unset, a start that
# finds no database refuses instead of creating one — the likely cause is an
# unmounted volume, and an empty purchasing system that looks healthy is worse
# than one that will not start.
# PCC_DATABASE_ALLOW_CREATE=1

# --- SERVER -----------------------------------------------------------------

PORT=3000
HOSTNAME=0.0.0.0

# How long a session lasts before it expires, in seconds. Default 12 hours,
# which is one working day plus the evening somebody finishes a PO.
SESSION_TTL_SECONDS=43200

# --- IDENTITY ---------------------------------------------------------------

# local    — email and password, verified against PCC's own store. No external
#            dependency. This is the pilot setting.
# supabase — Supabase Auth owns credentials, sessions and password resets.
#
# Leave this as `local` until IT has decided what the company uses. Switching
# later is a configuration change, not a rewrite.
AUTH_PROVIDER=local

# --- PERSISTENCE ------------------------------------------------------------

# local    — the SQLite file at PCC_DATABASE_PATH. One server, no network.
# supabase — a shared Postgres database, with row level security applied to the
#            signed-in caller. Requires AUTH_PROVIDER=supabase.
#
# This never infers itself from the presence of Supabase keys: moving where a
# company's purchasing records live is a deliberate act.
PURCHASING_PERSISTENCE=local

# --- SUPABASE (only if PURCHASING_PERSISTENCE or AUTH_PROVIDER is supabase) --
# The URL and anon key are public by design. The SERVICE ROLE key bypasses row
# level security, is used only for administrative acts, and must never reach a
# browser or a repository.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REDIRECT_URL=

# --- ATTACHMENTS ------------------------------------------------------------
# inline   — files are kept in the database. Correct while volumes are small;
#            it makes the backup a single file, which is the pilot's advantage.
# supabase — files go to object storage and the row keeps the path.
STORAGE_DRIVER=inline
STORAGE_BUCKET=purchasing

# --- EMAIL ------------------------------------------------------------------
# There is deliberately no transport setting. PCC composes vendor emails as
# DRAFTS and cannot send: a database CHECK constraint pins external sending to
# false. A person reviews every draft and sends it from their own mailbox.
# Enabling sending would be a reviewed migration and a new adapter, not a
# variable somebody flips.

# --- THE COMPANY, AS IT PRINTS ON A PURCHASE ORDER --------------------------
# Optional to START and required before the first real order: all three appear
# on the sheet that goes to a supplier. Set them here on a fresh install, or
# afterwards in the database. `pcc-verify-production.mjs` warns while they are
# missing.
PCC_ORG_NAME=Lippolis Electric, Inc.
PCC_ORG_PHONE=
PCC_ORG_ADDRESS=

# --- FIRST START ONLY -------------------------------------------------------
# These four exist for the very first start on a brand-new installation and
# should be REMOVED from the environment afterwards. PCC prints a reminder in
# the log when it uses them.
#
# PCC_DATABASE_ALLOW_CREATE authorizes creating a database that does not exist
# yet. Left set, it is not destructive — PCC opens the existing database and
# says so — but it removes the protection that catches an unmounted volume,
# which is the failure it was added for: without it, a missing mount produces a
# NEW EMPTY database rather than a refusal.
#
# The bootstrap administrator is the only account that exists on a fresh
# database. Sign in as them, invite the real users, change the password, and
# take the password out of this file.
PCC_DATABASE_ALLOW_CREATE=
PCC_BOOTSTRAP_ADMIN_EMAIL=
PCC_BOOTSTRAP_ADMIN_PASSWORD=
PCC_BOOTSTRAP_ADMIN_NAME=

# --- DEVELOPMENT ONLY -------------------------------------------------------
# The identity picker that skips the password. Refused in production.
PURCHASING_DEMO_MODE=0
