{
  "name": "purchasing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/apps/purchasing/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "bash ../../scripts/eval-purchasing-domain.sh",
    "test:integration": "bash ../../scripts/eval-purchasing.sh",
    "test": "npm run typecheck && npm run test:unit && npm run test:workflow && npm run test:providers && npm run test:isolation && npm run test:integration && npm run test:web",
    "test:web": "bash ../../scripts/eval-purchasing-web.sh",
    "test:providers": "bash ../../scripts/eval-purchasing-providers.sh",
    "test:isolation": "bash ../../scripts/eval-purchasing-isolation.sh",
    "test:workflow": "node ../../scripts/eval-workflow-engine.mjs",
    "test:operability": "node ../../scripts/eval-pcc-operability.mjs",
    "postbuild": "node ../../scripts/stage-standalone.mjs && node ../../scripts/check-deployable.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@supabase/supabase-js": "^2.110.7",
    "@awe/workflow": "*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
