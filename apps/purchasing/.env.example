# ---------------------------------------------------------------------------
# Purchasing Control Center — configuration
#
# Copy to .env.local and fill in. NO REAL SECRET BELONGS IN THIS FILE or in the
# repository; .env* is gitignored.
#
# Every variable here is read in exactly one place
# (src/purchasing/infrastructure/env.ts) and checked by validateEnvironment(),
# which the /api/health endpoint reports on. A misconfigured deployment says so
# out loud instead of failing at the first sign-in.
# ---------------------------------------------------------------------------

# --- how people sign in ------------------------------------------------------
# local    — email + password verified against the pilot's own scrypt store.
#            No external dependency; correct for the workshop pilot.
# supabase — Supabase Auth owns credentials, sessions and password resets.
#            Required before this is reachable from outside the shop.
# Unset means: supabase if the URL and anon key below are both set, else local.
AUTH_PROVIDER=local

# Signs the session cookie. MUST be set in production, MUST be at least 32
# characters, and changing it signs everyone out.
#   openssl rand -base64 48
SESSION_SECRET=

# How long a session lasts before it expires (seconds). Default: 12 hours.
SESSION_TTL_SECONDS=43200

# --- where the application lives ---------------------------------------------
# Absolute URL of this deployment. Used for password-reset links.
APP_BASE_URL=http://localhost:3000

# Where the credential provider sends a user after a password-reset email.
# Must be on the provider's allow-list. Defaults to APP_BASE_URL/reset-password.
AUTH_REDIRECT_URL=http://localhost:3000/reset-password

# --- Supabase (only when AUTH_PROVIDER=supabase) -----------------------------
# The project URL and anon key are public by design — the anon key is safe in a
# browser. The SERVICE ROLE key is not: it bypasses RLS, it is used only for
# administrative acts (invite, disable, force a password), and it must never be
# exposed to the client or committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- data --------------------------------------------------------------------
# WHERE THE COMPANY'S PURCHASING RECORDS LIVE. On a server this must be an
# absolute path inside the mounted persistent volume — never a path inside the
# container, whose contents a redeploy throws away.
#
#   PCC_DATABASE_PATH=/data/pcc.sqlite
#
# In production the application REFUSES TO START rather than guess this, and
# refuses if the directory does not exist, because both mistakes look identical
# to an operator: the app comes up, the health check is green, and the purchase
# orders are missing. In development it defaults to
# apps/purchasing/.data/purchasing.db and creates it on demand.
#
# PURCHASING_DB_PATH is the same setting under its older name. Either works;
# PCC_DATABASE_PATH wins if both are set.
PCC_DATABASE_PATH=

# FIRST START ONLY. With this unset, a production start that finds no database
# at PCC_DATABASE_PATH refuses — because the overwhelmingly likely cause is a
# volume that is not mounted, and creating a second, empty purchasing system
# beside the real one is worse than not starting. Set it to 1 once, start,
# then remove it.
PCC_DATABASE_ALLOW_CREATE=

# --- the server ---------------------------------------------------------------
# The port the application listens on. The container defaults to 3000.
PORT=3000

# The interface it binds to. 0.0.0.0 inside a container; leave it alone unless
# you know why you are changing it.
HOSTNAME=0.0.0.0

# Must be `production` on a server. It is what turns on the refusals above, and
# what makes a missing session secret fatal instead of a warning.
NODE_ENV=production

# --- attachments and documents -----------------------------------------------
# inline   — files are stored in the database (pilot only; fine for a few MB)
# supabase — files go to Supabase Storage and the row keeps the object path
STORAGE_DRIVER=inline
STORAGE_BUCKET=purchasing

# --- email -------------------------------------------------------------------
# There is deliberately NO transport setting. This application composes vendor
# emails as drafts and cannot send: `external_send_enabled` is a CHECK
# constraint pinned to false in migration 0016, so enabling sending is a
# reviewed migration and a new adapter, not a variable somebody flips.

# --- developer conveniences --------------------------------------------------
# 1 shows the identity picker on the sign-in screen, which skips the password.
# validateEnvironment() REFUSES this in production.
PURCHASING_DEMO_MODE=0

# --- persistence provider ----------------------------------------------------
# local    — the pilot's file-backed store (node:sqlite). One server, no network.
# supabase — the shared Postgres database. Requires AUTH_PROVIDER=supabase,
#            because every query is scoped by the CALLER's access token so RLS
#            applies to them rather than to a service role.
#
# This never infers itself from the presence of Supabase keys: moving where a
# company's purchasing records live is a deliberate act.
#
# NOT YET USABLE: the request-scoped wiring that supplies the caller's token is
# Checkpoint 1E. validateEnvironment() refuses the combination until then.
PURCHASING_PERSISTENCE=local
