.venv/
__pycache__/
*.pyc
.pytest_cache/

# Never commit credentials or customer documents.
.env
*.env
fixtures/
output/
*.docx
!assets/templates/*.docx

# Real customer documents and static assets are supplied locally.
*.pdf
!docs/**/*.pdf

# Job workspaces hold real customer documents, portal screenshots, HTML
# snapshots and manifests naming customers and sites. Never commit them.
work/
test-data/
# The controlled mock run's own workspace: exported PDFs, screenshots, HTML
# snapshots and an assembled DRAFT. All regenerable, none of it belongs here.
mock-run/
# Legacy Word documents -- the portal serves certificates as .doc.
*.doc
!assets/templates/*.doc
.DS_Store
*.egg-info/
build/
dist/

# Live-portal dry-run evidence: screenshots and HTML naming real
# customers and sites. Never commit.
TEGG-DRYRUN/
DRYRUN/
